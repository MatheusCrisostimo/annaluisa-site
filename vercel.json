{
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/acompanhar",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/agendar", "destination": "/agendar.html" },
    { "source": "/acompanhar", "destination": "/acompanhar.html" },
    { "source": "/noivas", "destination": "/noivas.html" },
    { "source": "/links", "destination": "/links/index.html" },
    { "source": "/midia-kit", "destination": "/midia-kit.html" }
  ]
}
